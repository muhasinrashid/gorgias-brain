# This is a template for the `.env` file that is used as part of local development.
# You can copy this file, rename it to `.env` and fill in the missing values,
# then delete this header.
###############################################################################

# This file should contain all the secrets required by *development* (local) application.
# This file is ignored by git by default to avoid accidentally exposing secrets in your repository.

SECRET_KEY="django-insecure-u88Rz3IURJksDn0NB1KNCa3fPJZ7UFOfTAgSGEMC"
# host should be "127.0.0.1" for native development or "db" for docker-based development
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/draftline"
# host should be "127.0.0.1" for native development or "redis" for docker-based development
REDIS_URL="redis://127.0.0.1:6379"

GOOGLE_ANALYTICS_ID=""
SENTRY_DSN=""

# Development server ports
DJANGO_PORT=8000
DJANGO_VITE_PORT=5173
# Set False to serve built assets from static/ without `npm run dev`
# DJANGO_VITE_DEV_MODE=False

# Docker service ports
POSTGRES_PORT=5432
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS="http://localhost:5174,http://127.0.0.1:5174"

# Social login credentials go here

GOOGLE_CLIENT_ID=""
GOOGLE_SECRET_ID=""

TWITTER_CLIENT_ID=""
TWITTER_SECRET_ID=""

GITHUB_CLIENT_ID=""
GITHUB_SECRET_ID=""

# turnstile setup - add your keys here to enable turnstile
TURNSTILE_KEY=""
TURNSTILE_SECRET=""

# put your stripe keys here
STRIPE_LIVE_PUBLIC_KEY="pk_live_***"
STRIPE_LIVE_SECRET_KEY="sk_live_***"
STRIPE_TEST_PUBLIC_KEY="pk_test_***"
STRIPE_TEST_SECRET_KEY="sk_test_***"

# public media storage config
USE_S3_MEDIA=False
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# You can uncomment these settings to use a different email backend in settings.py.
# Depending on your selected backend, you will probably need to add additional settings / environment variables

# DEFAULT_FROM_EMAIL="muhasin@gauger.in"
# SERVER_EMAIL="noreply@localhost:8000"
# EMAIL_BACKEND="anymail.backends.mailgun.EmailBackend"
# MAILGUN_API_KEY="key-***"
# MAILGUN_SENDER_DOMAIN="example.com"

HEALTH_CHECK_TOKENS=

ANTHROPIC_API_KEY="sk-ant-***"
DEFAULT_AI_MODEL="openai:gpt-5-mini"
OPENAI_API_KEY="sk-***"

# Azure OpenAI (preferred for Formex / hybrid ticket qualification)
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME="gpt-4o-mini"
QUALIFIER_LLM_CONFIDENCE_MIN=0.8
QUALIFIER_LLM_SUPPORT_CONFIDENCE_MIN=0.85

# Draftline credential encryption (leave blank to derive from SECRET_KEY)
CREDENTIAL_ENCRYPTION_KEY=""
CREDENTIAL_ENCRYPTOR="fernet"
DRAFT_SHADOW_MODE_DEFAULT=true
